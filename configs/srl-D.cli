# 1. Interfaces & System Loopback
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 4.4.4.4/32

set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.0.34.4/24

set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 10.0.41.4/24

# 2. Attach Interfaces to Default Network Instance
set / network-instance base interface system0.0
set / network-instance base interface ethernet-1/1.0
set / network-instance base interface ethernet-1/2.0

# 3. Routing Policy
set / routing-policy policy export-all default-action policy-result accept
set / routing-policy policy import-all default-action policy-result accept

# 4. BGP Protocol Configuration
set / network-instance base protocols bgp admin-state enable
set / network-instance base protocols bgp autonomous-system 65004
set / network-instance base protocols bgp router-id 4.4.4.4
set / network-instance base protocols bgp afi-safi ipv4-unicast admin-state enable

set / network-instance base protocols bgp group ebgp-peers admin-state enable
set / network-instance base protocols bgp group ebgp-peers export-policy [ export-all ]
set / network-instance base protocols bgp group ebgp-peers import-policy [ import-all ]

# Neighbor to srl-C
set / network-instance base protocols bgp neighbor 10.0.34.3 admin-state enable
set / network-instance base protocols bgp neighbor 10.0.34.3 peer-group ebgp-peers
set / network-instance base protocols bgp neighbor 10.0.34.3 peer-as 65003

# Neighbor to srl-A
set / network-instance base protocols bgp neighbor 10.0.41.1 admin-state enable
set / network-instance base protocols bgp neighbor 10.0.41.1 peer-group ebgp-peers
set / network-instance base protocols bgp neighbor 10.0.41.1 peer-as 65001

